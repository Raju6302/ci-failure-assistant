# Copy to .env (git-ignored) and fill in. Never commit real values.

# GitHub webhook secret: the same value you set on the GitHub App or repo webhook.
GITHUB_WEBHOOK_SECRET=

# Auth option A (recommended): GitHub App. See docs/github-app-setup.md
GITHUB_APP_ID=
# Save the App's .pem in ./secrets (git-ignored); compose mounts it at /run/secrets.
# Example: GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_APP_PRIVATE_KEY_PATH=

# Auth option B (local development): a fine-grained personal access token
# with "Actions: read" and "Contents: read" on the repos you test with.
GITHUB_TOKEN=

# Shared bearer token between the analysis worker and the MCP server (mcp-github-server).
# The worker sends it as "Authorization: Bearer <token>" on every /mcp request. Leave empty
# only for local experiments: without it, anyone who can reach port 8082 can use the tools.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
